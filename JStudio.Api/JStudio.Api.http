@JStudio.Api_HostAddress = http://localhost:5263

# Kör POST först. Byt 28 i PUT och DELETE mot det id som POST ger.

# Testnumren (Test 1, Test 2 …) är samma som i testloggen i "Redovisning APIAnnons.md".

# Test 1 – OK – förväntat 200 OK - resultat: 200 OK
GET {{JStudio.Api_HostAddress}}/Ads/
Accept: application/json

###
# Test 2 – OK – förväntat 200 OK - resultat: 200 OK
GET {{JStudio.Api_HostAddress}}/Ads/2
Accept: application/json

###
# Test 3 – förväntat 404 – resultt Finns inte 404 Not Found 
GET {{JStudio.Api_HostAddress}}/Ads/12
Accept: application/json

###
# Test 4 – förväntat 400 – resultat Ogiltig förfrågan Bad Request
GET {{JStudio.Api_HostAddress}}/Ads/abc
Accept: application/json

###
# Test 5 – förväntat 201 – resultat Skapad 201 Created
POST {{JStudio.Api_HostAddress}}/Ads
Content-Type: application/json 

{
  "title": "BallpointPens 0,4 mm, mörkgrå",
  "price": 54,
  "description": "Annan färg på locket, men knappt använd så fungerar som ny!",
  "location": "Strängnäs",
  "imageUrl": null,
  "category": "BallpointPens"
}

###
